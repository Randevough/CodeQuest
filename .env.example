# ==============================================================================
# CodeQuest Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# PostgreSQL Pooled Connection (Used by Prisma for runtime queries via PgBouncer)
DATABASE_URL="postgresql://postgres:password@localhost:6543/codequest?pgbouncer=true"

# PostgreSQL Direct Session Connection (Used by Prisma CLI for schema migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/codequest"

# NextAuth Secret (Minimum 32 random characters: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# Vercel Blob Storage Token (Optional in local development; required for file uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_mock_token_for_development"

# Upstash Redis REST Credentials (Required for rate-limiting and user cooldown tracking)
UPSTASH_REDIS_REST_URL="https://mock-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="mock-upstash-token"

# Email Mode: 'mock' (prints verification link to console) or 'smtp' (production delivery)
EMAIL_MODE="mock"
