// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  image     String?
  bio       String?
  githubUrl String?
  linkedinUrl String?
  handle    String?
  role      String?  @default("Member")
  password  String?
  points    Int      @default(0)
  completedQuests Int @default(0)
  
  snatches      Snatch[]
  penalties     Penalty[]
  accounts      Account[]
  badges        UserBadge[]
  notifications Notification[]
  squadsCreated Squad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String
  maxSnatchers Int      @default(1)
  
  difficulty  String   @default("Beginner") // Beginner, Intermediate, Advanced
  points      Int      @default(100)
  category    String   @default("Web") // Web, AI, Mobile
  status      String   @default("Draft") // Active, Draft, Closed
  
  deadline    DateTime?
  requirements String[]
  resources    String[]
  
  snatches    Snatch[]
  squads      Squad[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Squad {
  id          String   @id @default(cuid())
  questId     String
  name        String?
  createdById String
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
  snatches    Snatch[]
  createdAt   DateTime @default(now())

  @@index([questId])
}

model Snatch {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  status    String   @default("ACTIVE") // ACTIVE, SUBMITTED, REVISION_NEEDED, ACCEPTED, REJECTED, ARCHIVED, DROPPED
  
  user      User     @relation(fields: [userId], references: [id])
  quest     Quest    @relation(fields: [questId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt DateTime?
  submissionUrl String?
  feedback String? // Admin feedback on rejection/approval
  assignedById String?
  squadId      String?
  squad        Squad?   @relation(fields: [squadId], references: [id])

  @@unique([userId, questId]) // User can only snatch a quest once (until dropped/completed logic handled?)
  // Actually, if they drop it, can they snatch it again? 
  // For now, let's keep it unique to prevent double snatching.
}

model Penalty {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  expiresAt DateTime
  
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  imageUrl    String?
  category    String   // PROGRESSION, POINTS, CATEGORY, DIFFICULTY
  
  userBadges  UserBadge[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  isFeatured  Boolean  @default(false)
  
  user        User     @relation(fields: [userId], references: [id])
  badge       Badge    @relation(fields: [badgeId], references: [id])
  
  earnedAt    DateTime @default(now())

  @@unique([userId, badgeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // SUBMISSION_ACCEPTED | SUBMISSION_REVISION | SUBMISSION_REJECTED | BADGE_EARNED | QUEST_ASSIGNED
  message   String
  read      Boolean  @default(false)
  link      String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
